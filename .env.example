# These are retrieved from your project at app.tina.io
NEXT_PUBLIC_TINA_CLIENT_ID=***
TINA_TOKEN=***

# Contact form config
MAIL_USER=
MAIL_PASS=
# Email address to receive contact form submissions
NEXT_PUBLIC_CONTACT_EMAIL=hello@betania.de

# Site configuration
# Used for canonical URLs and Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://betania-ingolstadt.de

# This is set by default CI with Netlify/Vercel/Github, but can be overriden
NEXT_PUBLIC_TINA_BRANCH=***

# To see the preview functionality
VERCEL_ENV=preview

# Enable or disable locale switcher
ENABLE_LOCALE_SWITCHER=true

# List of enabled languages (comma-separated, e.g., de,ro for German and Romanian)
ENABLED_LOCALES=de,ro

# Comma-separated path prefixes to block in middleware and exclude from sitemap
# Examples: /posts,/events,/ro/legacy
IGNORED_PATHS=/posts